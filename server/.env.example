DATABASE_URL=postgresql://watcher:watcher_pass@localhost:5432/watcher_db
API_KEY=change_this_secret_key_123

# S3 — Timeweb Cloud Storage
S3_ENDPOINT_URL=https://s3.twcstorage.ru
S3_ACCESS_KEY=YOUR_ACCESS_KEY
S3_SECRET_KEY=YOUR_SECRET_KEY
S3_BUCKET=watcher
S3_REGION=ru-1-hot

# Хранение скриншотов: s3 или local
SCREENSHOT_STORAGE=s3

# Автоудаление старых данных (дней, 0 = не удалять)
RETENTION_DAYS=90
